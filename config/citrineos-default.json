{
  "name": "CitrineOS Default Configuration",
  "description": "Default configuration for OCPP tests with CitrineOS",
  "configurations": {
    "ocpp201": {
      "backendUrl": "ws://host.docker.internal:8080/ocpp20",
      "chargeBoxId": "charger-simulator-01",
      "authorizationKey": "",
      "pingInterval": 30,
      "reconnectInterval": 10,
      "staleTimeout": 300
    },
    "ocpp16": {
      "backendUrl": "ws://host.docker.internal:8080/ocpp16",
      "chargeBoxId": "charger-simulator-01-v16",
      "authorizationKey": "",
      "pingInterval": 30,
      "reconnectInterval": 10,
      "staleTimeout": 300
    },
    "localhost": {
      "ocpp201": {
        "backendUrl": "ws://localhost:8080/ocpp20",
        "chargeBoxId": "charger-simulator-01"
      },
      "ocpp16": {
        "backendUrl": "ws://localhost:8080/ocpp16",
        "chargeBoxId": "charger-simulator-01-v16"
      }
    },
    "production": {
      "ocpp201": {
        "backendUrl": "wss://your-citrineos-domain.com/ocpp20",
        "chargeBoxId": "charger-simulator-01",
        "authorizationKey": "your-production-key"
      }
    }
  },
  "testScenarios": [
    {
      "name": "Basic Connection",
      "description": "Test the WebSocket connection and BootNotification",
      "steps": [
        "Start the container",
        "Set the WebSocket configuration",
        "Verify the connection status",
        "Check the BootNotification in CitrineOS logs"
      ]
    },
    {
      "name": "Charging Session Simulation",
      "description": "Full charging flow from plug-in to end of session",
      "steps": [
        "Plug in the EVSE cable",
        "Plug in the EV cable",
        "Authorize with RFID",
        "Start charging",
        "Stop charging"
      ]
    }
  ]
}
